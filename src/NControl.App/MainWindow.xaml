<Window x:Class="NControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NControl.Presentation;assembly=NControl.Presentation"
        Title="NControl · Windows 控制中心"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 侧边导航 ===== -->
        <Border Grid.Column="0" Background="#FAFBFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="8,0,0,16">
                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource PrimaryGradientBrush}">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NControl" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Windows 控制中心" Style="{StaticResource SubtleText}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="主要功能" Style="{StaticResource SubtleText}" Margin="10,0,0,8" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="mainNav"
                                         IsChecked="{Binding IsActive, Mode=TwoWay}"
                                         Command="{Binding NavigateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="13.5" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border DockPanel.Dock="Top" Margin="0,16,0,0" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0" Padding="0,14,0,8" />

                <ItemsControl ItemsSource="{Binding BottomNavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="mainNav"
                                         IsChecked="{Binding IsActive, Mode=TwoWay}"
                                         Command="{Binding NavigateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="13.5" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ===== 主区域 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageDesc}" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="310" Height="40">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="12">
                                <Grid Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"
                                               Margin="0,0,9,0" />
                                    <TextBox x:Name="SearchBox" Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" FontSize="13"
                                             Foreground="{StaticResource TextBrush}"
                                             ToolTip="搜索功能、设置或工具" />
                                </Grid>
                            </Border>
                            <Popup PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                                   StaysOpen="False" IsOpen="{Binding SearchOpen}" AllowsTransparency="True"
                                   PopupAnimation="Fade" Width="360">
                                <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" Margin="0,6,0,0" MaxHeight="380">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}" Height="48"
                                                            HorizontalContentAlignment="Stretch" Padding="14,0"
                                                            Command="{Binding DataContext.ChooseSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtleText}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Width="40" Height="40" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Padding="0"
                                ToolTip="任务记录" Command="{Binding NavigateToRecordsCommand}">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource MutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,24,26,44">
                <ContentControl Content="{Binding CurrentPage}" />
            </ScrollViewer>

            <!-- 底部执行栏 -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="74" Background="#F2FFFFFF"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding BottomBarVisible, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedLabelText}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="将在执行前显示确认清单" Style="{StaticResource SubtleText}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="清空选择" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearSelectionCommand}" />
                        <Button Content="开始执行 →" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Command="{Binding ExecuteSelectionCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 执行弹窗遮罩 ===== -->
        <Grid Grid.ColumnSpan="2" Background="#33201B2D"
              Visibility="{Binding ExecDialog.IsOpen, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <ContentControl Content="{Binding ExecDialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
