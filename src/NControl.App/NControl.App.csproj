<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NControl.App</RootNamespace>
    <AssemblyName>NControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NControl.Core\NControl.Core.csproj" />
    <ProjectReference Include="..\NControl.Infrastructure\NControl.Infrastructure.csproj" />
    <ProjectReference Include="..\NControl.Modules.Optimization\NControl.Modules.Optimization.csproj" />
    <ProjectReference Include="..\NControl.Modules.Applications\NControl.Modules.Applications.csproj" />
    <ProjectReference Include="..\NControl.Modules.Cleanup\NControl.Modules.Cleanup.csproj" />
    <ProjectReference Include="..\NControl.Modules.Repair\NControl.Modules.Repair.csproj" />
    <ProjectReference Include="..\NControl.Modules.Tools\NControl.Modules.Tools.csproj" />
    <ProjectReference Include="..\NControl.Presentation\NControl.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 用户提供的离线软件载荷:发布时重命名到 NControl.exe 同级的 Installers 目录。 -->
  <ItemGroup>
    <None Include="..\..\StartAllBack-3.9.4.5256-Stbale-Repack.exe"
          Condition="Exists('..\..\StartAllBack-3.9.4.5256-Stbale-Repack.exe')"
          Link="Installers\StartAllBack_setup.exe"
          TargetPath="Installers\StartAllBack_setup.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\GeekUninstaller v1.5.1.162.exe"
          Condition="Exists('..\..\GeekUninstaller v1.5.1.162.exe')"
          Link="Installers\geek.exe"
          TargetPath="Installers\geek.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- 安全中心/Defender 彻底禁用:SuperUser + DEFENDER.CMD + 计划任务模板 -->
  <ItemGroup>
    <None Include="Tools\SecurityCenter\SUPERUSER32.EXE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Tools\SecurityCenter\SUPERUSER64.EXE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Tools\SecurityCenter\KILLSECURITYCENTER.CMD" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Tools\SecurityCenter\DEFENDER.CMD" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Tools\SecurityCenter\WINDOWS DEFENDER *.XML" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
