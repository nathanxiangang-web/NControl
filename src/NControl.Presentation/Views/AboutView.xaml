<UserControl x:Class="NControl.Presentation.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="关于" />
        <TextBlock Text="版本、技术基线与功能来源台账。" Style="{StaticResource MutedText}" Margin="0,4,0,14" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding ProductLine}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,6,0,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="版本 v{0}">
                            <Binding Path="Version" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="技术基线" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <ItemsControl ItemsSource="{Binding Baseline}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="第二代能力与边界" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <ItemsControl ItemsSource="{Binding ProductScope}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="功能来源台账" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Project}" FontSize="13.5" FontWeight="SemiBold" />
                                <Border Style="{StaticResource Pill}" Background="{StaticResource NeutralSoftBrush}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding License}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource NeutralBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,6,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="接入版本/提交:{0}">
                                        <Binding Path="Version" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,3,0,0" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="对应功能:{0}">
                                        <Binding Path="Functions" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,3,0,0" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="本地修改:{0}">
                                        <Binding Path="LocalChanges" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,3,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="验证环境:{0}">
                                        <Binding Path="VerifiedOn" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
