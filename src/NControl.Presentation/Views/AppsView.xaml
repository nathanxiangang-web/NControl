<UserControl x:Class="NControl.Presentation.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NControl.Presentation"
             xmlns:ctrl="clr-namespace:NControl.Presentation.Controls">
    <StackPanel>
        <!-- 工具栏:页签 + 扫描 -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="#EDF0F6" CornerRadius="12" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Tab}" Content="预装应用" IsChecked="True"
                                     Command="{Binding SelectTabCommand}" CommandParameter="0" />
                        <RadioButton Style="{StaticResource Tab}" Content="软件安装"
                                     Command="{Binding SelectTabCommand}" CommandParameter="3" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="重新扫描" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsScanning, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                <Button Content="扫描中…" Style="{StaticResource SecondaryButton}" IsEnabled="False"
                        Visibility="{Binding IsScanning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Grid>

        <!-- 预装应用页签内容 -->
        <StackPanel Visibility="{Binding ActiveTab, Converter={x:Static conv:IntEqualsToVisibilityConverter.Instance}, ConverterParameter=0}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18"
                    Visibility="{Binding BloatPreset, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="删除常见预装应用" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BloatPreset.Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding BloatPreset.CountText}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="选择方案" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                            Command="{Binding BloatPreset.SelectPlanCommand}" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="预装应用" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ScanStateText}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="勾选的项目在底部执行栏确认后统一执行;Microsoft Store 与关键运行库不在此列表中,始终保留。卸载为单向操作,需要时可从 Microsoft Store 重新安装。"
                       Style="{StaticResource SubtleText}" Margin="0,4,0,10" TextWrapping="Wrap" />

            <Border Style="{StaticResource Card}" Padding="0" CornerRadius="16">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10"
                                            Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconLetter}" Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Item.Name}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PackageName}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding InstalledText}" Style="{StaticResource SubtleText}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Border Grid.Column="4" Style="{StaticResource Pill}" Background="{StaticResource NeutralSoftBrush}">
                                        <TextBlock Text="{Binding KindText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding KindBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- 软件安装页签:常用软件官网入口(点击在浏览器打开官方下载页) -->
        <StackPanel Visibility="{Binding ActiveTab, Converter={x:Static conv:IntEqualsToVisibilityConverter.Instance}, ConverterParameter=3}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="软件安装" />
                    <TextBlock Text="常用软件官方下载入口。点击后在浏览器打开官网下载页,从官方渠道安装更安全。"
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding SoftwareEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ButtonText}" Style="{StaticResource SecondaryButton}"
                                        Height="30" Padding="12,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.InstallSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding InstallStatusText}" Style="{StaticResource SubtleText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryBrush}"
                       Visibility="{Binding InstallStatusText, Converter={x:Static conv:StringNotEmptyToVisibilityConverter.Instance}}" />
            <TextBlock Text="提示:从官方渠道下载安装,避免使用来路不明的安装包。" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
