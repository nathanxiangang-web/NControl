<UserControl x:Class="NControl.Presentation.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NControl.Presentation"
             xmlns:ctrl="clr-namespace:NControl.Presentation.Controls">
    <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="清理维护" />
        <TextBlock Text="先扫描了解可清理空间,再勾选项目执行;扫描数据来自真实统计,执行结果写入任务记录。" Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap" />

        <!-- 扫描区块(第二代 §9) -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="扫描可清理内容" />
                        <TextBlock Text="{Binding ScanProgressText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="开始扫描" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                            Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                </Grid>
                <TextBlock Text="{Binding ScanSummaryText}" Foreground="{StaticResource PrimaryBrush}" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ScanSummaryText, Converter={x:Static conv:StringNotEmptyToVisibilityConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding ScanRows}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource SubtleText}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 说明卡 -->
        <ItemsControl ItemsSource="{Binding SummaryCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,14,0" MinHeight="110">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 清理分组 -->
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,8" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                                    <ctrl:RiskPill Risk="{Binding Risk}" Margin="10,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding HintText}" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <CheckBox Style="{StaticResource Switch}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Right" />
                                                <Button Content="恢复" Style="{StaticResource GhostButton}" Height="28" Padding="10,0"
                                                        Margin="0,8,0,0" HorizontalAlignment="Right"
                                                        Visibility="{Binding CanRestore, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                                        Command="{Binding RestoreCommand}"
                                                        ToolTip="撤销该项优化,删除优化写入的配置并恢复系统默认值" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
