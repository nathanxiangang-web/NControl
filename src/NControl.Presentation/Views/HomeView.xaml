<UserControl x:Class="NControl.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Hero -->
        <Border CornerRadius="22" Padding="28,26">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#F7F7FF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#8D63F4" Opacity="0.14" />
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <StackPanel>
                <TextBlock Text="WINDOWS CONTROL CENTER" Foreground="{StaticResource PrimaryBrush}"
                           FontSize="12" FontWeight="Bold" Margin="0,0,0,7" />
                <TextBlock Text="欢迎使用 NControl" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="把零散的系统优化、应用精简、清理维护和故障修复,集中到一个清晰、可信的入口中。"
                           Style="{StaticResource MutedText}" FontSize="14" Margin="0,9,0,0" MaxWidth="620" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="开始推荐优化" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToOptimizeCommand}" />
                    <Button Content="打开系统修复" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                            Command="{Binding NavigateToRepairCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 快速开始 -->
        <TextBlock Text="快速开始" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="第二代强调真实状态、兼容性与可回滚,不展示虚假健康评分" Foreground="{StaticResource MutedBrush}"
                   FontSize="12" Margin="0,-40,0,12" HorizontalAlignment="Right" />
        <ItemsControl ItemsSource="{Binding QuickCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14" MinHeight="140">
                        <StackPanel>
                            <Border Style="{StaticResource IconBox}" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource GlyphText}" Text="{Binding Glyph}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,8,0,14" />
                            <Button Content="{Binding LinkText}" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Padding="0" Command="{Binding Command}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 常用工具 -->
        <TextBlock Text="常用工具" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding ToolCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,14,0" MinHeight="74">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource MiniIconBox}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource GlyphTextMuted}" Text="{Binding Glyph}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 最近执行 -->
        <TextBlock Text="最近执行" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="查看全部" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Margin="0,-40,0,12" HorizontalAlignment="Right" />
        <Border Style="{StaticResource Card}" Padding="0" CornerRadius="16">
            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                        Background="{Binding DotBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusGlyph}" FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding DotForeground}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource SubtleText}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Border Grid.Column="3" Style="{StaticResource Pill}" Background="{Binding PillBrush}">
                                    <TextBlock Text="{Binding PillText}" FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding PillForeground}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Text="暂无执行记录" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Recent.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
