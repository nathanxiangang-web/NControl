<UserControl x:Class="NControl.Presentation.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NControl.Presentation"
             xmlns:ctrl="clr-namespace:NControl.Presentation.Controls">
    <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="一键优化" />
        <TextBlock Text="选择一个适合当前电脑的方案,也可以展开查看具体项目。" Style="{StaticResource MutedText}" Margin="0,4,0,14" />

        <!-- 我的方案(第二代 §5):保存/导出/导入 -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="我的方案" />
                <TextBlock Text="把当前已选择的功能保存为配置,用于新电脑重复部署或分享。配置只引用功能项,不包含任何脚本。"
                           Style="{StaticResource MutedText}" Margin="0,4,0,10" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding PlanNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="10,6" FontSize="13"
                             BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                             ToolTip="方案名称" />
                    <Button Grid.Column="1" Content="保存为我的方案" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding SavePlanCommand}" />
                    <Button Grid.Column="2" Content="导出方案" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding ExportPlanCommand}" />
                    <Button Grid.Column="3" Content="从配置导入" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding ImportPlanCommand}" />
                </Grid>
                <TextBlock Text="{Binding PlanStatusText}" Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="{Binding PlanStatusText, Converter={x:Static conv:StringNotEmptyToVisibilityConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding MyPlans}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource SubtleText}" />
                                    <TextBlock Text="{Binding CompatText}" Foreground="{StaticResource WarningBrush}" FontSize="11"
                                               Visibility="{Binding CompatText, Converter={x:Static conv:StringNotEmptyToVisibilityConverter.Instance}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="加载" Style="{StaticResource GhostButton}" Height="26" Padding="10,0"
                                            Command="{Binding DataContext.LoadPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="删除" Style="{StaticResource GhostButton}" Height="26" Padding="10,0" Margin="6,0,0,0"
                                            Command="{Binding DataContext.DeletePlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 方案卡片 -->
        <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource Pill}" Background="{Binding PillBrush}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding TargetGroup}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding PillForeground}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding CompatText}" Foreground="{StaticResource WarningBrush}" FontSize="12"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding CompatText, Converter={x:Static conv:StringNotEmptyToVisibilityConverter.Instance}}" />
                                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,8,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="查看具体项目" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding Features}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                                   VerticalAlignment="Center" Margin="6,0,8,0" />
                                                        <ctrl:RiskPill Grid.Column="2" Risk="{Binding Risk}"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="部分项目未在当前功能目录中找到(可能在后续版本补充),不会被执行。"
                                                   Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                                                   Visibility="{Binding HasMissing, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="查看详情" Style="{StaticResource GhostButton}"
                                        Command="{Binding ToggleDetailsCommand}" />
                                <Button Content="选择方案" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                        Command="{Binding SelectPlanCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 自定义选择 -->
        <TextBlock Text="自定义选择" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="按分类进入" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Margin="0,-40,0,12" HorizontalAlignment="Right" />
        <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,14,0" MinHeight="74">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource MiniIconBox}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource GlyphTextMuted}" Text="&#xE945;" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
