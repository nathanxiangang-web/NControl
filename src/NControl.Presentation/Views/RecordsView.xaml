<UserControl x:Class="NControl.Presentation.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NControl.Presentation">
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="任务记录" />
                <TextBlock Text="每次执行都会生成一条记录,包含时间、项目和结果。" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Records}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource SubtleText}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding PillBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="Bold" Foreground="{Binding PillForeground}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="部分项目需要重启资源管理器或系统才能完全生效。"
                                       Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                                       Visibility="{Binding RequiresRestart, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                            <!-- 批次回滚(第二代 §8) -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding HasRestorable, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RollbackSummary}" Style="{StaticResource SubtleText}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="恢复本次任务" Style="{StaticResource SecondaryButton}"
                                            Height="28" Padding="12,0" Command="{Binding RollbackCommand}"
                                            IsEnabled="{Binding IsRollingBack, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                                            ToolTip="把本次任务已执行的功能项作为一个批次恢复(逆序),恢复本身会写入新的任务记录" />
                                </Grid>
                                <TextBlock Text="{Binding RollbackResultText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>

                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,8,0,0">
                                <Expander.Header>
                                    <TextBlock Text="查看明细" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                                        Padding="0,8" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontWeight="Bold"
                                                                   Foreground="{Binding StatusBrush}" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Status}" Style="{StaticResource SubtleText}" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}"
                                                                       TextWrapping="Wrap" FontFamily="Consolas"
                                                                       Visibility="{Binding Detail.Length, Converter={x:Static conv:IntEqualsToVisibilityConverter.Instance}, ConverterParameter=not0}" />
                                                            <TextBlock Text="{Binding ExitText}" Style="{StaticResource SubtleText}"
                                                                       Foreground="{StaticResource DangerBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Card}" Padding="30" Margin="0,8,0,0"
                Visibility="{Binding Records.Count, Converter={x:Static conv:IntEqualsToVisibilityConverter.Instance}, ConverterParameter=0}">
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}" TextAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
