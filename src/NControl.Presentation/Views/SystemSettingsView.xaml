<UserControl x:Class="NControl.Presentation.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NControl.Presentation"
             xmlns:ctrl="clr-namespace:NControl.Presentation.Controls">
    <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="系统设置" />
        <TextBlock Text="开关选中表示“选择应用”;已优化的项会显示“已优化”标识但不自动选中,避免重复执行。如需全部重跑一遍,点击“全部重新执行”。" Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap" />

        <!-- 分类标签 + 全部重新执行 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" Margin="0,0,8,8"
                                      IsChecked="{Binding IsActive, Mode=TwoWay}"
                                      Command="{Binding DataContext.SelectChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Title}" />
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="1" Content="全部重新执行" Style="{StaticResource SecondaryButton}" Height="30"
                    Margin="8,0,0,8" VerticalAlignment="Top"
                    Command="{Binding SelectAllForReapplyCommand}"
                    ToolTip="把当前分类的所有项(含已优化的)加入选择队列,底部确认后统一重新执行一遍" />
        </Grid>
        <TextBlock Text="{Binding ReapplyStatusText}" Style="{StaticResource SubtleText}" Margin="0,2,0,6" TextWrapping="Wrap"
                   Foreground="{StaticResource PrimaryBrush}"
                   Visibility="{Binding ReapplyStatusText, Converter={x:Static conv:StringNotEmptyToVisibilityConverter.Instance}}" />

        <!-- 设置分组 -->
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,8" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                                    <ctrl:RiskPill Risk="{Binding Risk}" Margin="10,0,0,0" />
                                                    <Border Style="{StaticResource Pill}" Background="{StaticResource NeutralSoftBrush}" Margin="8,0,0,0"
                                                            Visibility="{Binding IsHighRisk, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="仅高级区域" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource NeutralBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Background="{StaticResource SuccessSoftBrush}" Margin="8,0,0,0"
                                                            Visibility="{Binding IsOptimized, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="{Binding OptimizedText}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource SuccessBrush}" />
                                                    </Border>
                                                    <Border Margin="8,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                                <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OptimizedText}" Value="状态未知">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding OptimizedText}" FontSize="11" Foreground="{StaticResource NeutralBrush}" />
                                                    </Border>
                                                    <!-- 兼容性徽标(第二代 §4):不兼容=红,待验证=橙,未知=灰 -->
                                                    <Border Margin="8,0,0,0" ToolTip="{Binding CompatReason}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Background" Value="#FDECEA" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CompatText}" Value="待验证">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CompatText}" Value="兼容性未知">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding CompatText}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource NeutralBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding HintText}" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <CheckBox Style="{StaticResource Switch}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Right" />
                                                <Button Content="恢复" Style="{StaticResource GhostButton}" Height="28" Padding="10,0"
                                                        Margin="0,8,0,0" HorizontalAlignment="Right"
                                                        Visibility="{Binding CanRestore, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                                        Command="{Binding RestoreCommand}"
                                                        ToolTip="撤销该项优化,删除优化写入的配置并恢复系统默认值" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="当前分类下暂无设置项。" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
