<UserControl x:Class="NControl.Presentation.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="实用工具" />
        <TextBlock Text="查看与诊断工具点击即运行,输出在结果面板中展示。" Style="{StaticResource MutedText}" Margin="0,4,0,14" />

        <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" MinHeight="150" Margin="0,0,14,14">
                        <StackPanel>
                            <Border Style="{StaticResource IconBox}" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE950;" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,8,0,12" />
                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource SubtleText}" Margin="0,0,0,10" />
                            <Button Content="运行" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Padding="0" Command="{Binding RunCommand}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
